<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_bottom_nav_docked"
        android:paddingVertical="14dp"
        android:elevation="12dp">

        <!-- Header: Title & Close -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tvTitleSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/str_video_speed"
                android:textColor="@color/textColor"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/btnCloseSpeedSheet"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/textColor" />
        </RelativeLayout>

        <!-- Speed Mode Switcher: Standard vs Curva -->
        <LinearLayout
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_hero_bento_secondary"
            android:padding="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSpeedStandard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Standard"
                android:textColor="@color/onPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_pill_accent" />

            <TextView
                android:id="@+id/tabSpeedCurve"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Curva"
                android:textColor="@color/iconSecondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Container Standard Mode -->
        <LinearLayout
            android:id="@+id/layoutSpeedStandard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Speed Value Indicator -->
            <TextView
                android:id="@+id/tvSpeedValueDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="1.0x"
                android:textColor="@color/colorPrimaryVariant"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="4dp" />

            <!-- Continuous Speed Slider -->
            <SeekBar
                android:id="@+id/sliderSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:max="100"
                android:progress="10"
                android:progressTint="@color/colorPrimary"
                android:thumbTint="@color/onPrimary"
                android:layout_marginBottom="12dp" />

            <!-- Preset Pills (0.5x, 1x, 2x, 3x, 5x) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <LinearLayout
                        android:id="@+id/speedBtn05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp">
                        <FrameLayout
                            android:id="@+id/bgSpeed05"
                            android:layout_width="52dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <TextView
                                android:id="@+id/txtSpeed05"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="0.5x"
                                android:textColor="@color/iconSecondary"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/speedBtn10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp">
                        <FrameLayout
                            android:id="@+id/bgSpeed10"
                            android:layout_width="52dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_pill_accent">
                            <TextView
                                android:id="@+id/txtSpeed10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="1.0x"
                                android:textColor="@color/onPrimary"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/speedBtn15"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp">
                        <FrameLayout
                            android:id="@+id/bgSpeed15"
                            android:layout_width="52dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <TextView
                                android:id="@+id/txtSpeed15"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="1.5x"
                                android:textColor="@color/iconSecondary"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/speedBtn20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp">
                        <FrameLayout
                            android:id="@+id/bgSpeed20"
                            android:layout_width="52dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <TextView
                                android:id="@+id/txtSpeed20"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="2.0x"
                                android:textColor="@color/iconSecondary"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/speedBtn50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:id="@+id/bgSpeed50"
                            android:layout_width="52dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <TextView
                                android:id="@+id/txtSpeed50"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="5.0x"
                                android:textColor="@color/iconSecondary"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="14sp" />
                        </FrameLayout>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

        <!-- Container Velocity Curve Mode -->
        <LinearLayout
            android:id="@+id/layoutSpeedCurve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Interactive Speed Curve Canvas -->
            <com.antoniopennino.thecut.customviews.SpeedCurveView
                android:id="@+id/speedCurveView"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_hero_bento_secondary" />

            <!-- Curve Preset Options Carousel -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <!-- Flash In / Hero Preset -->
                    <LinearLayout
                        android:id="@+id/presetFlashIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="12dp">
                        <FrameLayout
                            android:id="@+id/bgPresetFlashIn"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_pill_accent">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_speed_24"
                                app:tint="@color/onPrimary" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Flash In"
                            android:textColor="@color/onPrimary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Bullet Time Preset -->
                    <LinearLayout
                        android:id="@+id/presetBulletTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="12dp">
                        <FrameLayout
                            android:id="@+id/bgPresetBulletTime"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_speed_24"
                                app:tint="@color/iconSecondary" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bullet Time"
                            android:textColor="@color/iconSecondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Montage Preset -->
                    <LinearLayout
                        android:id="@+id/presetMontage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="12dp">
                        <FrameLayout
                            android:id="@+id/bgPresetMontage"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_speed_24"
                                app:tint="@color/iconSecondary" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Montage"
                            android:textColor="@color/iconSecondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Flash Out Preset -->
                    <LinearLayout
                        android:id="@+id/presetFlashOut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="12dp">
                        <FrameLayout
                            android:id="@+id/bgPresetFlashOut"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_speed_24"
                                app:tint="@color/iconSecondary" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Flash Out"
                            android:textColor="@color/iconSecondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Custom / Reset Preset -->
                    <LinearLayout
                        android:id="@+id/presetCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <FrameLayout
                            android:id="@+id/bgPresetCustom"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_aspect_ratio_item">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_speed_24"
                                app:tint="@color/iconSecondary" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Lineare"
                            android:textColor="@color/iconSecondary"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

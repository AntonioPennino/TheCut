<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_bottom_nav_docked"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:elevation="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/str_subtitles"
                android:textColor="@color/textColor"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btnCloseSubtitlesSheet"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:tint="@color/activeTool"
                android:contentDescription="Close" />
        </RelativeLayout>

        <!-- No subtitles state -->
        <LinearLayout
            android:id="@+id/layoutNoSubtitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoGenerateSubtitles"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/str_auto_generate_subtitles"
                android:textAllCaps="false"
                android:textColor="@color/onPrimaryContainer"
                android:backgroundTint="@color/colorPrimary"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_closed_caption_24"
                app:iconSize="20dp"
                app:iconTint="@color/onPrimaryContainer"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadSrt"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/str_upload_subtitle_file"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textAllCaps="false"
                android:textColor="@color/textColor"
                app:strokeColor="@color/outline"
                app:cornerRadius="22dp"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/str_supports_standard_srt_formatte"
                android:textColor="@color/outline"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Subtitles active state -->
        <LinearLayout
            android:id="@+id/layoutHasSubtitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingVertical="4dp">

            <!-- Subtitle info & Quick Action Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_bottom_nav"
                android:padding="8dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_closed_caption_24"
                    app:tint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvSubtitleFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/str_subtitles_srt"
                    android:textColor="@color/textColor"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium" />

                <!-- Bulk Edit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBulkEditSubtitles"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/str_bulk_edit"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/colorPrimary"
                    app:strokeColor="@color/colorPrimary"
                    app:cornerRadius="18dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <!-- Single Cue Edit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditCurrentCue"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/str_cue"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="@color/textColor"
                    app:strokeColor="@color/outline"
                    app:cornerRadius="18dp"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="4dp" />

                <!-- Export SRT Button -->
                <ImageButton
                    android:id="@+id/btnExportSrt"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_save_alt_24"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    app:tint="@color/textColor"
                    android:contentDescription="Export SRT" />

                <!-- Change SRT Button -->
                <ImageButton
                    android:id="@+id/btnChangeSrt"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_swap_24"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    app:tint="@color/textColorSecondary"
                    android:contentDescription="Change Subtitle File" />
            </LinearLayout>

            <!-- Subtitle Font Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:minWidth="52dp"
                    android:layout_height="wrap_content"
                    android:text="Font"
                    android:textColor="@color/textColor"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:id="@+id/btnSelectSubtitleFont"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/tool_button_inactive"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvSelectedSubtitleFontName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Roboto Regular"
                        android:textColor="@color/textColor"
                        android:textSize="13sp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_drop_down_24"
                        app:tint="@color/textColor" />
                </LinearLayout>
            </LinearLayout>

            <!-- Font Size Slider Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_text_24"
                    app:tint="@color/iconSecondary" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/subtitleFontSizeSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="10.0"
                    android:valueTo="80.0"
                    android:value="22.0"
                    android:stepSize="1.0"
                    app:thumbColor="@color/colorPrimary"
                    app:trackColorActive="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvSubtitleFontSizeValue"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/str_22"
                    android:textColor="@color/textColor"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Bottom Action Buttons: Remove & Save -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteSrt"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/str_remove"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textAllCaps="false"
                    android:textColor="@color/accentRose"
                    app:strokeColor="@color/accentRose"
                    app:cornerRadius="22dp"
                    android:layout_marginEnd="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSubtitles"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/str_save"
                    android:backgroundTint="@color/colorPrimary"
                    android:textColor="@android:color/white"
                    app:cornerRadius="22dp"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
